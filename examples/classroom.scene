version 1;

include "chair.model";
include "desk.model";

render iso;
scale 32;
canvas (34, 20, 4);
sun (135, 45);
ambient 0.35;
background #1a1c22;

// Четыре ряда по пять парт.
for row in 0..4 {
    for col in 0..5 {
        let x = col * 7;
        let y = row * 5;

        place desk at (x, y, 0) rot 0;
        place chair at (x + 2.6, y + 2.4, 0) rot 180;
    }
}
