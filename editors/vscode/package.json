{
  "name": "iso-scene",
  "displayName": "iso-scene",
  "description": "Живой предпросмотр iso-scene: изометрия, чертёж, воксели",
  "publisher": "local-iso",
  "version": "0.3.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:iso-scene",
    "onCommand:isoScene.preview"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "iso-scene",
        "aliases": [
          "iso-scene",
          "Iso Scene"
        ],
        "extensions": [
          ".scene",
          ".model",
          ".walls"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "iso-scene",
        "scopeName": "source.iso-scene",
        "path": "./syntaxes/iso-scene.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "isoScene.preview",
        "title": "Scene: открыть предпросмотр"
      },
      {
        "command": "isoScene.build",
        "title": "Scene: собрать"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "isoScene.preview",
          "when": "editorLangId == iso-scene",
          "group": "navigation"
        },
        {
          "command": "isoScene.build",
          "when": "editorLangId == iso-scene",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Iso Scene",
      "properties": {
        "isoScene.executable": {
          "type": "string",
          "default": "iso-scene",
          "description": "Путь к CLI iso-scene. Если не найден в PATH, берётся ~/.cargo/bin/iso-scene."
        },
        "isoScene.updateDelay": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "description": "Задержка живого обновления, мс."
        }
      }
    }
  }
}
